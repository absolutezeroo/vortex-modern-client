!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
.idea/
.idea/**
_bmad/
_bmad-output/
node_modules/
sources/
dist/
tools/
!packages/vortex-client/tools/
!packages/vortex-client/tools/*.mjs
!packages/vortex-glaze/tools/
!packages/vortex-glaze/tools/*.mjs
!packages/vortex-imager/tools/
