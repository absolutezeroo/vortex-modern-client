{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/eslint-fix-hook.mjs\"",
            "statusMessage": "eslint --fix",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
