# =================================================================================================
# The hotel's website
# =================================================================================================
# packages/vortex-web — the habbo-web port. It is the apex: what a visitor lands on. The game client
# is a separate resource on its own host, and /hotel mounts it in an iframe with the SSO ticket on
# the query string, the way habbo.com mounts its own.
#
# This host proxies only what the site itself calls, which is less than the client needs:
#
#   /api/*            the web API — login, registration, avatars, languages. NOT rewritten: unlike
#                     the client's `/webapi`, these paths are already what the emulator serves.
#   /habbo-imaging/*  avatars, badges and room renders on the site's own pages.
#
# Everything else the site loads is absolute and points elsewhere: c_images at the asset host
# (VITE_ASSET_BASE), and the client at its own host (VITE_CLIENT_URL). Both are build arguments —
# see Dockerfile.web.

{
	# Coolify's proxy terminates TLS in front of this container, so Caddy serves plain HTTP on :80
	# and must not try to obtain a certificate of its own.
	auto_https off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$EMULATOR_UPSTREAM}:8080
	}

	handle /habbo-imaging/* {
		reverse_proxy {$IMAGER_UPSTREAM}:8081
	}

	# Build output, before the fallback and deliberately without it. Every name under /assets is
	# content-hashed, so a request for one that is missing is a bug and has to say so. Under the
	# fallback below it answered `index.html` with a 200 instead — which is exactly how this site
	# shipped with no sprite sheet and a green deploy log: the browser asked for an image, got HTML,
	# and nothing anywhere reported a problem.
	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		file_server

		# svelte-spa-router routes on the hash, so every real path is already a file and there is
		# no history fallback to arrange. `try_files` stays anyway for the one case it covers: a
		# deep link typed without the hash should land on the site rather than a 404.
		try_files {path} /index.html
	}
}
