<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_perfmon" width="500" height="430" version="0.1">
  <window>
    <frame x="50" y="45" width="500" height="430" params="1073774593" style="3"
           name="perfmon_frame" caption="Frame budget" color="0xff418db0" width_min="480">
      <filters>
        <DropShadowFilter distance="4" alpha="0.34901960784313724" blurX="4" blurY="4"/>
      </filters>
      <children>
        <tab_context x="0" y="2" width="500" height="30" params="16" style="3" name="perfmon_tabs">
          <children>
            <tab_button x="0" y="0" width="70" height="32" params="17" style="3"
                        name="perfmon_tab_live" caption="Live"/>
            <tab_button x="70" y="0" width="70" height="32" params="17" style="3"
                        name="perfmon_tab_runs" caption="Runs"/>
            <tab_button x="140" y="0" width="80" height="32" params="17" style="3"
                        name="perfmon_tab_bench" caption="Bench"/>
            <tab_button x="220" y="0" width="90" height="32" params="17" style="3"
                        name="perfmon_tab_profile" caption="Profile"/>
          </children>
        </tab_context>

        <container x="1" y="32" width="498" height="50" params="16" style="3" name="header_container">
          <children>
            <container x="0" y="0" width="498" height="50" params="16" style="3" name="header_border" color="0xffff486f81" background="true">
              <children>
                <container x="2" y="2" width="494" height="46" params="16" style="3" name="header_inner" color="0xffff235061" background="true"/>
              </children>
            </container>
            <container x="0" y="0" width="500" height="50" params="16" style="3" name="header_detail">
              <children>
                <static_bitmap x="8" y="20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="78" y="-20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="148" y="20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="218" y="-20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="288" y="20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="358" y="-20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
                <static_bitmap x="428" y="20" width="64" height="51" params="16" style="3" blend="0.3">
                  <variables>
                    <var key="asset_uri" value="wired_box_lines_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
              </children>
            </container>
            <text x="0" y="14" width="500" height="21" params="16" style="3" name="header_title" caption="Header%20Title">
              <variables>
                <var key="auto_size" value="center" type="String"/>
                <var key="font_size" value="16" type="uint"/>
                <var key="text_color" value="0xffffff" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
                <var key="bold" value="true" type="Boolean"/>
                <var key="spacing" value="0" type="Number"/>
                <var key="leading" value="0" type="Number"/>
              </variables>
            </text>
            <region x="473" y="3" width="22" height="25" params="1" style="3" dynamic_style="brightness_and_shadow_under_gentle" name="discord_region" treshold="0">
              <children>
                <static_bitmap x="0" y="1" width="22" height="23" params="16" style="3" tags="%23icon">
                  <variables>
                    <var key="asset_uri" value="icon_discord_png" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="etching_color" value="0x48000000" type="hex"/>
                    <var key="fit_size_to_contents" value="true" type="Boolean"/>
                  </variables>
                </static_bitmap>
              </children>
              <variables>
                <var key="tool_tip_caption" value="${wiredmenu.discord_region.tooltip}" type="String"/>
              </variables>
            </region>
          </children>
        </container>

        <!-- Live: graph on top, four labelled figures underneath. Every tab uses this same shape -
             controls, graph, then one row of label/value pairs - so moving between them does not
             mean relearning where to look. -->
        <container x="1" y="82" width="500" height="386" params="147600" style="3"
                   name="perfmon_page_live" height_min="340">
          <children>
            <bitmap x="0" y="0" width="544" height="226" params="16" style="3" name="perfmon_graph"/>

            <text x="4" y="234" width="130" height="14" params="16400" style="3" caption="FRAMES PER SECOND">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="4" y="248" width="130" height="22" params="3932176" style="3" name="perfmon_v_fps" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="140" y="234" width="130" height="14" params="16400" style="3" caption="MS PER FRAME">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="140" y="248" width="130" height="22" params="3932176" style="3" name="perfmon_v_frame" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="276" y="234" width="130" height="14" params="16400" style="3" caption="COMPOSITIONS / FRAME">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="276" y="248" width="130" height="22" params="3932176" style="3" name="perfmon_v_comps" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="412" y="234" width="130" height="14" params="16400" style="3" caption="MS PER COMPOSITION">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="412" y="248" width="130" height="22" params="3932176" style="3" name="perfmon_v_per" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="4" y="284" width="536" height="16" params="16400" style="3" name="perfmon_breakdown" caption="-">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="4" y="304" width="536" height="16" params="16400" style="3"
                  caption="green = frames per second      red = whole frame      blue = room.obj">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
          </children>
        </container>

        <!-- Runs: the picker sits above its graph, so the title and the buttons that change it are
             next to each other rather than at opposite corners. -->
        <container x="1" y="82" width="500" height="386" params="147600" style="3"
                   name="perfmon_page_runs" height_min="340">
          <children>
            <text x="4" y="6" width="330" height="20" params="3932176" style="3"
                  name="perfmon_run_title" caption="no runs on disk">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>
            <button x="338" y="2" width="56" height="24" params="17" style="3"
                    name="perfmon_run_prev" caption="Prev"/>
            <button x="398" y="2" width="56" height="24" params="17" style="3"
                    name="perfmon_run_next" caption="Next"/>
            <button x="458" y="2" width="82" height="24" params="17" style="3"
                    name="perfmon_run_reload" caption="Reload"/>

            <bitmap x="0" y="32" width="544" height="204" params="16" style="3" name="perfmon_run_graph"/>

            <text x="4" y="244" width="130" height="14" params="16400" style="3" caption="SAMPLES">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="4" y="258" width="130" height="22" params="3932176" style="3" name="perfmon_r_samples" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="140" y="244" width="130" height="14" params="16400" style="3" caption="FPS START / END">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="140" y="258" width="130" height="22" params="3932176" style="3" name="perfmon_r_fps" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="276" y="244" width="130" height="14" params="16400" style="3" caption="MS PER COMPOSITION">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="276" y="258" width="130" height="22" params="3932176" style="3" name="perfmon_r_per" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="412" y="244" width="130" height="14" params="16400" style="3" caption="DRIFT">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="412" y="258" width="130" height="22" params="3932176" style="3" name="perfmon_r_drift" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="4" y="294" width="536" height="30" params="16400" style="3" name="perfmon_run_note" caption="">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="multiline" value="true" type="Boolean"/>
                <var key="word_wrap" value="true" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>

        <!-- Bench: the controls are the point of this tab, so they come first and the graph fills
             what is left rather than leaving a blank half-window while nothing is running. -->
        <container x="1" y="82" width="500" height="386" params="147600" style="3"
                   name="perfmon_page_bench" height_min="340">
          <children>
            <text x="4" y="4" width="200" height="16" params="16400" style="3" caption="SPAWN WALKING AVATARS">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <button x="4" y="22" width="112" height="26" params="17" style="3"
                    name="perfmon_bench_20" caption="20 avatars"/>
            <button x="120" y="22" width="112" height="26" params="17" style="3"
                    name="perfmon_bench_60" caption="60 avatars"/>
            <button x="236" y="22" width="112" height="26" params="17" style="3"
                    name="perfmon_bench_100" caption="100 avatars"/>
            <button x="440" y="22" width="100" height="26" params="17" style="3"
                    name="perfmon_bench_stop" caption="Stop"/>

            <text x="4" y="56" width="536" height="18" params="3932176" style="3"
                  name="perfmon_bench_status" caption="idle">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>
            <text x="4" y="76" width="536" height="30" params="16400" style="3"
                  caption="Uses figures already in the room, records once a second for 15s, then writes the run to perf/ and clears itself. It appears in the Runs tab straight away.">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="multiline" value="true" type="Boolean"/>
                <var key="word_wrap" value="true" type="Boolean"/>
              </variables>
            </text>

            <bitmap x="0" y="112" width="544" height="200" params="16" style="3" name="perfmon_bench_graph"/>

            <text x="4" y="320" width="170" height="14" params="16400" style="3" caption="ELAPSED">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="4" y="334" width="170" height="22" params="3932176" style="3" name="perfmon_b_elapsed" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="190" y="320" width="170" height="14" params="16400" style="3" caption="FRAMES PER SECOND">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="190" y="334" width="170" height="22" params="3932176" style="3" name="perfmon_b_fps" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>

            <text x="376" y="320" width="164" height="14" params="16400" style="3" caption="MS PER FRAME">
              <variables><var key="auto_size" value="left" type="String"/></variables>
            </text>
            <text x="376" y="334" width="164" height="22" params="3932176" style="3" name="perfmon_b_frame" caption="-">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>

        <!-- Profile: what the last bench run actually spent its time in, by function. The browser's
             own sampler only sees JavaScript stacks, so time inside drawImage or getImageData is
             charged to the function that called it - the attribution that reading a DevTools native
             total by eye gets wrong. -->
        <container x="1" y="82" width="500" height="386" params="147600" style="3"
                   name="perfmon_page_profile" height_min="340">
          <children>
            <text x="4" y="6" width="330" height="20" params="3932176" style="3"
                  name="perfmon_p_title" caption="no profile yet">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
              </variables>
            </text>
            <button x="338" y="2" width="156" height="24" params="17" style="3"
                    name="perfmon_p_refresh" caption="Show last run"/>
            <text x="4" y="30" width="490" height="300" params="16400" style="3"
                  name="perfmon_p_table" caption="Run a bench and the heaviest functions appear here.">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="multiline" value="true" type="Boolean"/>
                <var key="word_wrap" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>
      </children>
      <variables>
        <var key="margin_left" value="0" type="int"/>
        <var key="margin_top" value="36" type="int"/>
        <var key="margin_right" value="0" type="int"/>
        <var key="margin_bottom" value="0" type="int"/>
      </variables>
    </frame>
  </window>
</layout>
