<?xml version="1.0" encoding="UTF-8"?>
<!--
  The furni editor's entry point: one button, added as a list item to the furni infostand's
  infostand_element_list at runtime.

  It lives in its own authored layout rather than in furni_view because furni_view ships verbatim
  from the Habbo dump and is regenerated by tools/build-window-assets.mjs — an edit there would be
  both a divergence from the dump and lost on the next asset build.
-->
<layout name="vortex_furni_editor_button" width="180" height="30">
  <window>
    <container x="0" y="0" width="180" height="30" params="16" style="3" name="vortex_furni_editor_button_row">
      <children>
        <button x="0" y="2" width="150" height="26" params="1" style="102" name="vortex_furni_editor_open" caption="${vortex.furni_editor.open}" dynamic_style="button">
          <variables>
            <var key="text_style" value="il_button" type="String"/>
          </variables>
        </button>
      </children>
    </container>
  </window>
</layout>
