<?xml version="1.0" encoding="UTF-8"?>
<!--
  The fishing strip: what is on screen while a session runs.

  **Origins has no fishing-spot panel.** Its cast carries thirteen window definitions — Hook Havoc,
  the Fish-O-Pedia, three store screens and the derby's — and not one of them is a spot. Clicking the
  water starts fishing and opens nothing. The panel this replaces (`vortex_fishing_spot_xml`) was
  invented, and it showed.

  What Origins *does* have is a set of plates the compiled Lingo draws directly: `fish_lvl_box`,
  `fish_lvl_max_box`, `fish_currency_box`, `fish_currency_icon` and `fishing_progress_bar` are all in
  the cast and in none of the thirteen windows. So the pieces here are Origins'; their arrangement is
  this port's, because the arrangement is in Lingo nobody has read yet. Every plate is drawn at its
  own native size except the background, which stretches — a wide rounded plate is what stretching is
  for.

  Vortex-only: no counterpart in any Habbo *Flash* dump, so it lives here rather than in
  src/assets/window-layouts/, which is gitignored and regenerated by tools/build-window-assets.mjs.
-->
<layout name="vortex_fishing_hud" width="360" height="52" version="0.1">
  <window>
    <container x="24" y="120" width="360" height="52" params="1073741840" style="0"
               name="fishing_hud_root">
      <children>

        <!-- Origins' cream plate, the only piece here that is stretched. -->
        <static_bitmap x="0" y="0" width="360" height="52" params="16" style="0" name="hud_bg">
          <variables>
            <var key="asset_uri" value="fish_currency_box" type="String"/>
          </variables>
        </static_bitmap>

        <!--
          The level slot. Origins ships two: a tan one and a gold star one for a player at the cap,
          so the second sits on top of the first and is revealed by `visible` rather than swapping
          an image — the idiom Achievement.xml uses.
        -->
        <static_bitmap x="10" y="8" width="25" height="23" params="16" style="0" name="hud_level_box">
          <variables>
            <var key="asset_uri" value="fish_lvl_box" type="String"/>
          </variables>
        </static_bitmap>
        <static_bitmap x="10" y="8" width="25" height="23" params="16" style="0"
                       name="hud_level_box_max" visible="false">
          <variables>
            <var key="asset_uri" value="fish_lvl_max_box" type="String"/>
          </variables>
        </static_bitmap>

        <!--
          The level number, over the slot. Placed by hand: this window system parses no text
          alignment and a label always draws from its left edge — see .claude/rules/window-ui.md.
          Two digits measure ~13px in the default 12px face, so 10 + (25 - 13) / 2 = 16.
        -->
        <text x="16" y="13" width="16" height="14" params="144" style="0"
              name="hud_level" caption=""/>

        <!--
          The XP trough, at Origins' own 241x25, and the fill inside its border. The border is 4px,
          so the fill starts at 44+4, 8+4 and can run 233 wide — FishingHudView sets that width every
          time the state changes. The green pixel is 1x1 and the window stretches it, which is how
          Origins draws its own bars.
        -->
        <static_bitmap x="44" y="8" width="241" height="25" params="16" style="0" name="hud_xp_trough">
          <variables>
            <var key="asset_uri" value="fishing_progress_bar" type="String"/>
          </variables>
        </static_bitmap>
        <static_bitmap x="48" y="12" width="1" height="17" params="16" style="0" name="hud_xp_fill">
          <variables>
            <var key="asset_uri" value="fishingUI_green_pixel" type="String"/>
          </variables>
        </static_bitmap>

        <!-- The token count: Origins' own 10x18 fish icon, and the number beside it. -->
        <static_bitmap x="300" y="10" width="10" height="18" params="16" style="0" name="hud_token_icon">
          <variables>
            <var key="asset_uri" value="fish_currency_icon" type="String"/>
          </variables>
        </static_bitmap>
        <text x="314" y="12" width="40" height="14" params="144" style="0"
              name="hud_tokens" caption=""/>

        <!-- "340 / 500", under the trough. -->
        <text x="44" y="34" width="120" height="14" params="144" style="0"
              name="hud_xp" caption=""/>

        <!--
          The last catch, and the shadow cue before it. Without this the feature is silent: the
          session runs unattended, so nothing else on screen ever says what was landed.
        -->
        <text x="170" y="34" width="180" height="14" params="144" style="0"
              name="hud_status" caption=""/>

      </children>
    </container>
  </window>
</layout>
