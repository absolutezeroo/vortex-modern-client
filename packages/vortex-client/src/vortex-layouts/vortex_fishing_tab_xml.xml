<?xml version="1.0" encoding="UTF-8"?>
<!--
  The inventory's fishing tab button.

  Vortex-only. It lives in its own authored layout rather than in `inventory_xml` because that one
  ships verbatim from the Habbo dump and is regenerated by tools/build-window-assets.mjs — an edit
  there would be both a divergence from the dump and lost on the next asset build. The same reason
  the furni editor's button has its own layout.

  `InventoryMainView` builds this and calls `tabs.addTabItem()` once the dump's own tabs have been
  extracted and re-added; see the attach point there.

  The shape (tab_container_button + label child, params 147473) is copied from the dump's own
  `collectibles` tab so the button behaves and draws like every other one.
-->
<layout name="vortex_fishing_tab" width="87" height="34">
  <window>
    <tab_container_button x="0" y="0" width="87" height="34" params="147473" style="3"
                          name="fishing" caption="%24%7Bvortex.fishing.tab%7D">
      <children>
        <!--
          The margins are not decoration: every tab button in the dump's `inventory_xml` carries
          exactly these four on its label, and they are what centres the caption inside the tab
          skin. Without them the text sits at 0,0 in the corner and the tab renders as a bare box
          next to its neighbours.
        -->
        <label x="0" y="0" width="87" height="34" params="16" style="3"
               caption="%24%7Bvortex.fishing.tab%7D">
          <variables>
            <var key="margin_left" value="10" type="int"/>
            <var key="margin_top" value="7" type="int"/>
            <var key="margin_right" value="10" type="int"/>
            <var key="margin_bottom" value="10" type="int"/>
          </variables>
        </label>
      </children>
    </tab_container_button>
  </window>
</layout>
