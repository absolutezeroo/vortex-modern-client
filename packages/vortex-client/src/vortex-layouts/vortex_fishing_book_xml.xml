<?xml version="1.0" encoding="UTF-8"?>
<!--
  The fishing tab's contents — the records book.

  Vortex-only, authored here for the same reason as the tab button: `inventory_xml` ships verbatim
  from the dump. `FishingBookModel.getWindowContainer()` hands this to the inventory, which parents
  it into its own main container and stretches it to height.

  It draws the **whole** species table from FishingDefinitions and greys out every row the player has
  no record for. That visible gap is the progression loop — a list of only what you have caught would
  say nothing about what is left.

  Two panes, the same shape the furni tab uses: the list on the left, a detail pane on the right that
  fills in for whatever row the pointer is over. The four availability axes — hour, weekday, season,
  zone — decide as much as the level gate and are readable nowhere else.

  Size copied from the dump's own category containers (468x261, params 2064) so it drops into the
  same slot as `furni` or `collectibles`.
-->
<layout name="vortex_fishing_book" width="468" height="261">
  <window>
    <container x="0" y="0" width="468" height="261" params="2064" style="3"
               name="fishing" visible="false">
      <children>

        <border x="0" y="0" width="468" height="46" params="144" style="3"
                name="fishing_header" color="0x0cacaca">
          <children>
            <!--
              The rod's quality tier, as the five-slot indicator. It reads the ROD, not the fishing
              level: the sprite set runs 0-5 and rod quality is the only quantity in this system on
              that scale — the fishing level goes to 100 and would have to be bucketed to fit, which
              would tell the player something less precise than the number already beside it.
            -->
            <bitmap x="8" y="5" width="98" height="18" params="16" style="0"
                    name="fishing_rod_quality"/>

            <text x="112" y="6" width="196" height="16" params="144" style="0"
                  name="fishing_level_text" caption=""/>
            <text x="8" y="25" width="300" height="16" params="144" style="0"
                  name="fishing_progress_text" caption=""/>
            <!--
              The token, beside its count. Exactly 10x18 — Origins' own `fish_currency_icon`, and the
              slot has to match it: a bitmap window stretches its content to its own size, so a 20x15
              box squashed a portrait sprite into a landscape one.
            -->
            <bitmap x="316" y="5" width="10" height="18" params="80" style="0"
                    name="fishing_currency_icon"/>

            <text x="332" y="6" width="128" height="16" params="80" style="0"
                  name="fishing_currency_text" caption=""/>
            <text x="316" y="25" width="144" height="16" params="80" style="0"
                  name="fishing_caught_text" caption=""/>
          </children>
        </border>

        <!--
          Narrower than the container by the scrollbar's width. Twelve species is already more than
          fits, and an operator's table can hold fifty (the later Origins update added exactly that),
          so the list has to scroll rather than clip.
        -->
        <!--
          `params` ends in 1 — `WindowParam.INPUT_EVENT_PROCESSOR` (0x1). Without that bit the
          window processes no input at all, so `ItemListController.process()` never sees `WME_WHEEL`
          and the list scrolls only by dragging the bar. The dump's scrollable message list carries
          it too (0x891); it was missing here (0x100480).
        -->
        <itemlist_vertical x="0" y="52" width="270" height="209" params="2193" style="3"
                           name="fishing_species_list"/>

        <!--
          Bound to the list by name through the `scrollable` variable, which is what
          `ScrollBarController` reads to find its target — the pairing the dump's Achievements
          layout uses. Without the variable the bar renders and scrolls nothing.
        -->
        <scrollbar_vertical x="270" y="52" width="18" height="209" params="2129" style="3"
                            name="fishing_species_scrollbar">
          <variables>
            <var key="scrollable" value="fishing_species_list" type="String"/>
          </variables>
        </scrollbar_vertical>

        <!--
          The detail pane. Filled by whichever row the pointer is over, and left showing the prompt
          until one is. Everything in it comes from the species definition the server pushed.
        -->
        <border x="294" y="52" width="174" height="209" params="2128" style="3"
                name="fishing_detail" color="0x0cacaca">
          <children>
            <text x="8" y="8" width="158" height="16" params="144" style="0"
                  name="detail_name" caption=""/>

            <!--
              The fish itself — Habbo Origins' own `fishpedia_*_preview`, extracted from
              hh_fishing.cct. They vary up to 63x45, so the slot is the largest of them and
              FishingBookView centres each one inside it rather than stretching: a small fish blown
              up to the slot would be a blur.
            -->
            <bitmap x="8" y="28" width="63" height="45" params="16" style="0"
                    name="detail_image"/>

            <bitmap x="76" y="42" width="61" height="17" params="16" style="0"
                    name="detail_stars"/>

            <text x="8" y="80" width="158" height="16" params="144" style="0"
                  name="detail_zone" caption=""/>
            <text x="8" y="98" width="158" height="16" params="144" style="0"
                  name="detail_level" caption=""/>

            <text x="8" y="120" width="158" height="16" params="144" style="0"
                  name="detail_hours" caption=""/>
            <text x="8" y="138" width="158" height="16" params="144" style="0"
                  name="detail_days" caption=""/>
            <text x="8" y="156" width="158" height="16" params="144" style="0"
                  name="detail_seasons" caption=""/>

            <text x="8" y="176" width="158" height="16" params="144" style="0"
                  name="detail_weight" caption=""/>
            <text x="8" y="192" width="158" height="16" params="144" style="0"
                  name="detail_record" caption=""/>
          </children>
        </border>

      </children>
    </container>
  </window>
</layout>
