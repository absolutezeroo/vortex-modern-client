<?xml version="1.0" encoding="UTF-8"?>
<!--
  One species row in the fishing tab's list.

  Vortex-only. Built once per species by FishingBookView and added to `fishing_species_list`.

  A row the player has never caught is still drawn — dimmed, with its record columns empty. Hiding it
  would remove the only thing that tells a player what is left to find, which is the whole point of
  the tab (see docs/vortex-original/fishing.md 2.6).
-->
<layout name="vortex_fishing_species_row" width="270" height="22">
  <window>
    <!--
      `params` ends in 1 — WindowParam.INPUT_EVENT_PROCESSOR. Without it the row processes no input,
      so it never sees the pointer and the detail pane never fills.
    -->
    <container x="0" y="0" width="270" height="22" params="17" style="3" name="fishing_species_row">
      <children>
        <text x="6" y="3" width="140" height="16" params="144" style="0"
              name="row_name" caption=""/>
        <!--
          Five stars at a 12px stride (the sprite is 13 wide, so they overlap by one). Drawn by
          FishingBookView from `star_small_gold`, not a font glyph: the row used to print `★`
          characters, which pick up whatever the text style's colour and metrics happen to be.
        -->
        <bitmap x="150" y="1" width="61" height="17" params="16" style="0"
                name="row_stars"/>
        <text x="214" y="3" width="52" height="16" params="144" style="0"
              name="row_level" caption=""/>
        <!--
          The hover underline, under the NAME only and sized to the rendered text — a link's
          underline, not a full-width rule. FishingBookView reads `row_name.textWidth` and resizes
          this to match, then toggles it on WME_OVER / WME_OUT.

          Hidden here rather than shown-and-recoloured, because a row that has never been hovered
          must not draw a line at all. Its width is a placeholder; the code always sets it.
        -->
        <border x="6" y="18" width="1" height="1" params="16" style="3"
                name="row_underline" color="0xff000000" visible="false"/>
      </children>
    </container>
  </window>
</layout>
