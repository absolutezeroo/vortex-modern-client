<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hook Havoc — rebuilt from Habbo Origins' own `fishingUI.window`, which is in
  docs/vortex-original/origins/fishingUI.window.txt beside the member inventory it was read from.

  Every position and size below is Origins'. The board is 160x243 and everything sits on it: the
  dial at 22,73, the two key buttons at 41,208 and 83,208, the seconds line at 26,176, the fill bar
  at 28,54. Where this deviates it says so.

  **The dial is one bitmap slot, not four.** Origins layers `fishingUI_mittari`, `viisari1` (the
  needle), `viisari2` (its pivot ball) and a fish preview as separate sprites and rotates the needle
  at draw time. This window system has no sprite rotation, so `HookHavocView` composites the four
  into a single ImageBitmap each tick — same result, and one window instead of four that would have
  to be kept in step. It is the ONE slot here that code has to fill; everything else names its own
  image below, so this layout renders in vortex-glaze and can be edited there.

  Note `fishingUI_viisari1` is a 42x112 member that Origins' window definition draws at 11x28 —
  a cast member's size is not its draw size. HookHavocView scales it; see NEEDLE_WIDTH there.

  Vortex-only: no counterpart in any Habbo *Flash* dump, so it lives here rather than in
  src/assets/window-layouts/, which is gitignored and regenerated by tools/build-window-assets.mjs.
-->
<layout name="vortex_fishing_hookhavoc" width="160" height="243" version="0.1">
  <window>
    <container x="140" y="120" width="160" height="243" params="1073741841" style="0"
               name="hookhavoc_root">
      <children>

        <!-- The wooden board the whole panel is drawn on. -->
        <static_bitmap x="0" y="0" width="160" height="243" params="16" style="0" name="hh_bg">
          <variables>
            <var key="asset_uri" value="fishingUI_bg" type="String"/>
          </variables>
        </static_bitmap>

        <!-- ${vortex.fishing.hook_havoc.title}, centred, in the board's red plaque. -->
        <text x="35" y="16" width="90" height="14" params="144" style="0"
              name="hh_title" caption=""/>

        <!--
          Origins' `fishing_bar`: a single green pixel stretched to show progress — a bitmap window
          stretches its content to the slot by default (BitmapDataController's `stretched_x`), so
          HookHavocView only has to set the width. The width here is that of an empty bar.
        -->
        <static_bitmap x="28" y="54" width="1" height="10" params="16" style="0" name="hh_fill">
          <variables>
            <var key="asset_uri" value="fishingUI_green_pixel" type="String"/>
          </variables>
        </static_bitmap>

        <!-- The composited dial: gauge, needle, pivot, and the fish being fought. -->
        <bitmap x="22" y="73" width="110" height="122" params="16" style="0"
                name="hh_dial"/>

        <!-- "X seconds left" — Origins shows a countdown, which is what makes the bar urgent. -->
        <text x="26" y="176" width="104" height="12" params="144" style="0"
              name="hh_seconds" caption=""/>

        <!--
          The two keys, as buttons. Origins draws `fishingUI_button_active` with the letter as a
          text field over it and a finger cursor, so they are clickable as well as typable — a
          player who does not know about Q and E can still play.

          Pressed state is a second bitmap under the first, revealed by toggling `visible` — the
          idiom every shipped layout with two states uses (see Achievement.xml's
          bg_unselected_bitmap / bg_selected_bitmap). Swapping the image in code instead would work
          but would re-resolve an asset on every tick of the attempt.
        -->
        <static_bitmap x="41" y="208" width="30" height="30" params="17" style="0" name="hh_key_left">
          <variables>
            <var key="asset_uri" value="fishingUI_button_active" type="String"/>
          </variables>
        </static_bitmap>
        <static_bitmap x="41" y="208" width="31" height="31" params="16" style="0"
                       name="hh_key_left_down" visible="false">
          <variables>
            <var key="asset_uri" value="fishingUI_button_dark" type="String"/>
          </variables>
        </static_bitmap>

        <static_bitmap x="83" y="208" width="30" height="30" params="17" style="0" name="hh_key_right">
          <variables>
            <var key="asset_uri" value="fishingUI_button_active" type="String"/>
          </variables>
        </static_bitmap>
        <static_bitmap x="83" y="208" width="31" height="31" params="16" style="0"
                       name="hh_key_right_down" visible="false">
          <variables>
            <var key="asset_uri" value="fishingUI_button_dark" type="String"/>
          </variables>
        </static_bitmap>

        <!--
          The key letters, each spanning its own button.

          Origins centres them with `#alignment: "center"`; here that is `auto_size="center"`, which
          492 shipped layouts use. **`auto_size` is a string, not the boolean its name suggests** —
          `left` / `center` / `right` / `none` — and `TextSkinRenderer` shifts the line by
          `(maxWidth - textWidth) / 2` for `center`. Each field therefore spans its button and the
          glyph finds its own centre. Placing an x per letter by hand, which is what this did first,
          is both unnecessary and wrong the moment the font changes: Q and E do not measure the same.
        -->
        <text x="41" y="215" width="30" height="14" params="144" style="0" name="hh_key_left_text" caption="Q">
          <variables>
            <var key="auto_size" value="center" type="String"/>
          </variables>
        </text>
        <text x="83" y="215" width="30" height="14" params="144" style="0" name="hh_key_right_text" caption="E">
          <variables>
            <var key="auto_size" value="center" type="String"/>
          </variables>
        </text>
      </children>
    </container>
  </window>
</layout>
