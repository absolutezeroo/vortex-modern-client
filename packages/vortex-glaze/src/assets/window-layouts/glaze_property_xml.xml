<?xml version="1.0" encoding="UTF-8"?>
<!-- Flat panel, same shape as glaze_hierarchy_xml — see the note there. -->
<layout name="glaze_property" width="356" height="600">
  <window>
    <container x="0" y="0" width="356" height="600" params="1" style="3" name="glaze_property_frame" background="true" color="0xfff0f0f0">
      <children>
        <container x="0" y="0" width="356" height="22" params="144" style="3" name="glaze_property_header" background="true" color="0xffe2e2e2">
          <children>
            <text x="0" y="3" width="356" height="16" params="208" style="3" name="glaze_property_title" caption="Property Editor" color="0xff2b2b33">
              <variables>
                <var key="auto_size" value="left" type="String"/>
                <var key="text_style" value="il_button" type="String"/>
                <var key="bold" value="true" type="Boolean"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>
        <scrollable_itemlist_vertical x="0" y="22" width="356" height="578" params="16" style="100" name="glaze_property_list">
          <variables>
            <var key="resize_on_item_update" value="false" type="Boolean"/>
          </variables>
        </scrollable_itemlist_vertical>
      </children>
    </container>
  </window>
</layout>
