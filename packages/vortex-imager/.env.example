# vortex-imager — copy to .env and adjust, or export these in the process environment.

# ── HTTP ─────────────────────────────────────────────────────────────────────
IMAGER_HOST=0.0.0.0
IMAGER_PORT=8081

# ── Hotel assets ─────────────────────────────────────────────────────────────
# Where the asset host answers. Everything else — which avatar build is current,
# where the badge parts live — is read from that host's external_variables, the
# same file the client reads, so it is never configured twice.
IMAGER_ASSETS_BASE_URL=http://vortex-assets.local
IMAGER_EXTERNAL_VARIABLES_URL=http://vortex-assets.local/gamedata/external_variables/1

# Optional. Set it when the imager runs on the machine that serves the assets and
# every read skips HTTP. Leave it unset to fetch over the network like the client.
#IMAGER_ASSETS_ROOT=C:/Laragon/www/vortex-assets

# Hotel environment suffix in common_configuration_txt (en, s2, …).
IMAGER_ENVIRONMENT_ID=en

# ── Database (read-only) ─────────────────────────────────────────────────────
# Required for ?user= lookups, for guild badges and for room rendering: the badge
# part catalogue, the room models and the placed furniture are all the server's
# data. Leave IMAGER_DB_DATABASE empty to run figure-only, with the badge and room
# routes answering 503. /habbo-imaging/furniture works without it.
IMAGER_DB_HOST=127.0.0.1
IMAGER_DB_PORT=3306
IMAGER_DB_USER=root
IMAGER_DB_PASSWORD=
IMAGER_DB_DATABASE=
IMAGER_DB_POOL=4

# ── CORS ─────────────────────────────────────────────────────────────────────
# The client loads avatars and badges with crossOrigin="anonymous" (it reads them
# back off a canvas), so the browser drops any response without this header when
# the imager is on a different origin than the client. `*` is correct for public
# images with no credentials; narrow it to the hotel's origin if you prefer.
IMAGER_CORS_ORIGIN=*

# ── Cache ────────────────────────────────────────────────────────────────────
IMAGER_CACHE_ENTRIES=2000
IMAGER_CACHE_TTL_MS=21600000

# Avatars, badges and furniture are also kept on disk, so a restart does not
# re-render the hotel: a figure string, a badge code and a furni's parameters
# fully describe their pixels, so the same URL can only ever produce the same
# bytes. Rooms are never written there — their URL names a room, not its
# contents. Defaults to `cache/` next to the package; set it empty to disable.
#
# The path includes the hotel's asset build, so updating the client leaves the
# old images in a directory nothing reads any more. Deleting it is the whole of
# cache invalidation.
#IMAGER_CACHE_DIR=

# Rooms get their own, much shorter TTL. Every other image here is immutable for
# its URL; a room's contents change whenever someone moves a chair, and nothing
# tells the imager when that happened.
IMAGER_ROOM_CACHE_TTL_MS=60000

# trace | debug | info | warn | error | silent
IMAGER_LOG_LEVEL=info
